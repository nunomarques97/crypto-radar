# Narrow line-ending rule for the locked benchmark corpus fixtures only.
#
# Scope is deliberately exactly this one directory, never the whole repository:
# `radar_v08/adapters/benchmark_corpus.py` hashes every case and the lock over
# *canonical JSON* (`json.dumps(..., sort_keys=True, separators=(",", ":"))`, see
# `canonical_sha256`), which re-serializes the parsed content and therefore does not
# see raw line endings at all — a CRLF checkout does not change any sha256 the loader
# checks (verified before and after this file was added, inside a disposable local
# clone). The rule below is defensive, not a fix for a reproduced
# break: it keeps `git diff`/`git show` of these JSON fixtures free of line-ending noise
# and keeps the checked-in bytes (`i/lf w/lf` today) stable across OSes regardless of a
# clone's `core.autocrlf`, without touching end-of-line handling anywhere else in the repo.
tests/fixtures/benchmark_corpus/** text eol=lf

# The imported trend-feasibility records and the trend parity fixtures are
# pinned by the sha256 of their exact bytes (the imported registry hash chain is over its CRLF line
# bytes). Store and check them out without any line-ending conversion. Scope: these two directories.
docs/audit/2026-10-03-trend-feasibility/** -text
tests/fixtures/trend/** -text
